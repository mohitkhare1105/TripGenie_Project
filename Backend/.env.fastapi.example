# TripGenie AI - FastAPI Backend Environment Configuration Example
# Copy this file to .env or set environment variables accordingly.

PORT=8000
FASTAPI_PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Groq API Configuration (Phase 4 Primary LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30.0

# Google Gemini API Configuration (Legacy/Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Database & Authentication Configuration (Phase 2)
# Obtain these from your Supabase Project Settings -> API & Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Security and Rate Limiting
MAX_BODY_SIZE_BYTES=102400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
