# TripGenie AI - FastAPI Backend Environment Configuration Example
# Copy this file to .env or configure in your deployment platform (e.g. Render).

PORT=8000
FASTAPI_PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Groq API Configuration (Phase 4 Primary LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30.0

# Unsplash API Configuration (Phase 5 Destination Images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_TIMEOUT=10.0

# Supabase Database & Authentication Configuration (Phase 2)
# Obtain these from your Supabase Project Settings -> API & Auth
SUPABASE_URL=SUPABASE_URL
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Security and Rate Limiting
MAX_BODY_SIZE_BYTES=102400
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
